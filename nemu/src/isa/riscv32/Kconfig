menu "ISA-dependent Options for riscv"

config RV64
  bool "64-bit RISC-V architecture"
  default n

config RVE
  bool "Use E extension"
  default n

config RVA
  bool "Use A extension"
  default n

config RVC
  bool "Use C extension"
  default n

config RVDF
  bool "Use DF extension"
  default n
endmenu
