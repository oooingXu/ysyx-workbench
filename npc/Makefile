# Include variables and rules generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf
-include $(NPC_HOME)/include/config/auto.conf.cmd

# Include rules for menuconfig
include $(NPC_HOME)/scripts/config.mk

# Include files for cpp or c
-include $(NPC_HOME)/scripts/build.mk

# rules for NVBoard
include $(NVBOARD_HOME)/scripts/nvboard.mk

ifdef CONFIG_SOC
TOP_NAME = ysyxSoCFull
endif

ifdef CONFIG_NPC
TOP_NAME = ysyx_23060336
endif

CPU_NAME = ysyx_23060336
VERILATOR = verilator
PRJ = playground
NXDC_FILES = constr/top.nxdc
MICROBENCH = microbench-riscv32e-ysyxsoc.bin
INC_PATH ?=

BUILD_DIR = ./build
OBJ = ./obj_dir
VSRC = ./vsrc
SOC_HOME = $(NPC_HOME)/../ysyxSoC
PERF = ./perf
PERF_REF = $(PERF)/ysyxSoCFull
PERF_BIN = $(PERF)/$(MICROBENCH)
CACHESIM = $(PERF)/cachesim
YOSYS = ../yosys-sta
RISCV_TEST_AM = $(NPC_HOME)/../riscv-tests-am
KONATA_HOME = $(NPC_HOME)/tools/Konata


KONATA = $(KONATA_HOME)/konata.sh
PIPELINE_LOG = $(BUILD_DIR)/pipeline.log
COREMARK_BIN = ./resource/coremark-riscv32-npc.bin
CACHESIM_BIN = $(PERF)/pc_trace.bin
BIN = $(BUILD_DIR)/$(TOP_NAME)
NPC = $(NPC_HOME)/csrc/$(CPU_NAME).cpp

DIFF_REF_PATH = $(NEMU_HOME)/build
DIFF_REF_SO ?= $(DIFF_REF_PATH)/riscv32-nemu-interpreter-so
ifdef CONFIG_DIFFTEST
endif

default: $(BIN)

#$(shell mkdir -p $(BUILD_DIR))

VERILATOR_CFLAGS += $(shell llvm-config --cflags) 
VERILATOR_CFLAGS += $(shell sdl2-config --cflags) 
VERILATOR_CFLAGS += -MMD --cc --trace-fst\
									 	-O3 --x-assign fast --x-initial fast\
									 	--exe -Wno-DECLFILENAME\
										--timescale "1ns/1ns" --no-timing\
										--assert --autoflush \
										--build\
										#--lint-only -Wall -Wno-DECLFILENAME -Wno-UNUSED

ifdef CONFIG_SOC
# constraint file
SRC_AUTO_BIND = $(abspath $(BUILD_DIR)/auto_bind.cpp)
$(SRC_AUTO_BIND): $(NXDC_FILES)
	python3 $(NVBOARD_HOME)/scripts/auto_pin_bind.py $^ $@

VSRCS += $(SOC_HOME)/build/ysyxSoCFull.v
VSRCS += $(shell find $(SOC_HOME)/perip -name "*.v")

INVFLAGS += -I$(SOC_HOME)/perip/uart16550/rtl
INVFLAGS += -I$(SOC_HOME)/perip/spi/rtl
endif

CPU := $(abspath $(NPC_HOME)/vsrc/$(CPU_NAME).sv)
CSRCS += $(SRC_AUTO_BIND)
CSRCS += $(NPC)

INVFLAGS ?= 

INCFLAGS = $(addprefix -I, $(INC_PATH))
CXXFLAGS += $(INCFLAGS) -DTOP_NAME="\"V$(TOP_NAME)\"" 
CXXFLAGS += -mcmodel=medium -Wno-format -Wno-shift-count-overflow -Wno-deprecated -Wno-return-type -g

IMG ?= 
NPC_EXEC := $(BIN) $(IMG) $(DIFF_REF_SO) 

CONFIG_VARS := CONFIG_KONATA=$(CONFIG_KONATA) \
               CONFIG_NPC=$(CONFIG_NPC) \
               CONFIG_RVE=$(CONFIG_RVE) \
							 CONFIG_VERILATOR_SIM=$(CONFIG_VERILATOR_SIM) \
							 CONFIG_ICACHE=$(CONFIG_ICACHE)

$(BIN): $(CPU) $(VSRCS) $(CSRCS) $(NVBOARD_ARCHIVE)
	@rm -rf $(OBJ)
	$(VERILATOR) $(VERILATOR_CFLAGS) \
		-top-module $(TOP_NAME) $^ \
	 	$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
		$(INVFLAGS) --exe -o $(abspath $(BIN))

# rules for verilator
all: default

sim: $(BIN)
	$(call git_commit, "sim RTL")

test:
	mill -i $(PRJ).test

$(CPU):: verilog

verilog:
	$(call git_commit, "generate verilog")
	mkdir -p $(BUILD_DIR)
	mkdir -p $(VSRC)
	$(CONFIG_VARS) mill -i $(PRJ).runMain Elaborate --target-dir $(VSRC)
	sed -i '/----- 8< ----- FILE "firrtl_black_box_resource_files.f" ----- 8< -----/,$$d' $(CPU)

run_test: $(BIN)
	$(call git_commit, "run run_test")
	$(MAKE) -C $(RISCV_TEST_AM) ARCH=riscv32im-npc ALL=add sim

run: $(BIN)
	$(call git_commit, "run NPC")
	$(NPC_EXEC) 

gdb: $(BIN)
	$(call git_commit, "gdb NPC")
	gdb -s $(BIN) --args $(NPC_EXEC) 

help:
	mill -i $(PRJ).runMain Elaborate --help

reformat:
	mill -i __.reformat

checkformat:
	mill -i __.checkFormat

sta:
	$(MAKE) -C $(YOSYS) sta

rpt:
	$(MAKE) -C $(YOSYS) rpt

wave:
	gtkwave build/waveform.fst

perf_soc:
	$(PERF_REF) $(PERF_BIN)

perf_npc:
	$(BIN) $(COREMARK_BIN) $(DIFF_REF_SO)

cachesim:
	@gcc $(CACHESIM).c -o $(CACHESIM)
	@$(CACHESIM) $(CACHESIM_BIN)

konata:
	$(KONATA) $(PIPELINE_LOG)

clean:
	rm -rf $(BUILD_DIR) test_run_dir $(OBJ) $(VSRC) waveform.*
	$(MAKE) -C $(YOSYS) clean

cleansim:
	rm -rf performance_trace.csv $(OBJ) $(BUILD_DIR)

.PHONY:	default all	run test verilog help reformat checkformat clean sim wave cleansim perf cachesim sta rpt

include ../Makefile

