mainmenu "ysyx_23060336 Configuration Menu"

menu "ISA-dependent Options for riscv"
config NPC
	bool "riscv32e-npc"
	default n
config SOC
	bool "riscv32e-ysyxsoc"
	default y
endmenu

choice
	prompt "Running mode"
	default MODE_SYSTEM

config MODE_SYSTEM
	bool "System mode"
endchoice

config BATCH
	bool "Enable batch"
	default y

menu "Testing and Debugging"

config TRACE
	bool "Enable tracer"
	default y

config TRACE_START
	depends on TRACE
	int "When tracing is enabled (uint: number of instructions)"
	default 0

config TRACE_END
	depends on TRACE
	int "When tracing is disabled (uint: number of instructions)"
	default 10000

config ITRACE
	depends on TRACE
	bool "Enable instruction itracer"
	default y

config ITRACE_COND
	depends on IRACE
	string "Only trace instructions when the condition is true"
	default "true"

config MTRACE
	depends on TRACE
	bool "Enable instruction mtracer"
	default n

config SMTRACE
	depends on MTRACE
	bool "Enable instruction sramtracer"
	default n

config PMTRACE
	depends on MTRACE
	bool "Enable instruction psramtracer"
	default n

config FMTRACE
	depends on MTRACE
	bool "Enable instruction flashtrace"
	default n

config COUNTER
	depends on TRACE
	bool "Enable instruction performance counter"
	default y

config PCOUNTER
	depends on COUNTER
	bool "Enable instruction performance counter"
	default n

config DTRACE
	depends on TRACE
	bool "Enable instruction dtracer"
	default n

config FTRACE
	depends on TRACE
	bool "Enable instruction ftracer"
	default n

config RTRACE
	depends on TRACE
	bool "Enable instruction rtracer"
	default n

config CTRACE
	depends on TRACE
	bool "Enable instruction ctrace"
	default n

config IRINGBUF
	depends on TRACE
	bool "Enable printf iringbuf when abort"
	default n

config IRINGBUF_DEBUG
	depends on IRINGBUF
	bool "Enable debug iringbuf"
	default n

config DIFFTEST
 depends on TRACE
 bool "Enable instruction difftest"
 default n

config PTRACE
	depends on DIFFTEST
	bool "Enable instruction ptracer"
	default n

config DIFFMEM_DEBUG
	depends on DIFFTEST
	bool "Enable printf diff mem"
	default n

config ABORTRUN
	depends on TRACE
	bool "Enable run when abort"
	default n

config WAVE
	depends on TRACE
	bool "Enable open gtkwave"
	default n

config LIGHTSSS
	depends on TRACE
	bool "Enable open lightsss"
	default n

endmenu

if MODE_SYSTEM
source "csrc/device/Kconfig"
endif

